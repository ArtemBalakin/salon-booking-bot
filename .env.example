# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не должен попадать в git (см. .gitignore).

# Токен бота из @BotFather
BOT_TOKEN=

# Username бота без @, например booking_almaty_bot
BOT_USERNAME=

# Telegram chat_id владельца салона — сюда будут приходить уведомления о новых записях.
# Можно узнать, написав боту @userinfobot
ADMIN_CHAT_ID=

# Публичный HTTPS-адрес, на котором будет доступно приложение (нужен для кнопки Mini App).
# Для локального теста без Telegram можно оставить http://localhost:8081 — сама кнопка бота
# работать не будет (Telegram требует https), но API и /miniapp можно открыть в браузере напрямую.
APP_BASE_URL=http://localhost:8081

# Название и адрес салона — попадают в сообщения клиентам (адрес можно оставить пустым)
SALON_NAME=Салон красоты
SALON_ADDRESS=

# true — новые записи ждут подтверждения админа кнопками в боте; false — подтверждаются сразу.
# Если ADMIN_CHAT_ID не задан, записи всегда подтверждаются автоматически.
MANUAL_CONFIRMATION=true

# Часовой пояс салона (расписание и напоминания считаются в нём)
APP_TIMEZONE=Asia/Almaty

# Порт, на котором приложение слушает снаружи контейнера
APP_PORT=8081

# База данных (можно оставить значения по умолчанию для локальной разработки)
DB_NAME=booking_bot
DB_USER=booking_bot
DB_PASSWORD=booking_bot
